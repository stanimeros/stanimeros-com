rules_version = '2';

// Single admin UID owns this project's data, so client reads/writes are
// gated directly by auth.uid instead of proxying everything through Cloud
// Functions.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth.uid == "77b21jE09te0JZ7msT8wCdaExmF3";
    }
  }
}
