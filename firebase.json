{
  "hosting": [
    {
    "target": "main",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/terms",
        "destination": "/privacy-policy",
        "type": 301
      },
      {
        "source": "/privacy",
        "destination": "/privacy-policy",
        "type": 301
      },
      {
        "source": "/portfolio",
        "destination": "/projects",
        "type": 301
      },
      {
        "source": "/el/portfolio",
        "destination": "/el/projects",
        "type": 301
      },
      {
        "source": "/work/:slug",
        "destination": "/projects/:slug",
        "type": 301
      },
      {
        "source": "/el/work/:slug",
        "destination": "/el/projects/:slug",
        "type": 301
      },
      {
        "source": "/en",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/en/:rest*",
        "destination": "/:rest*",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|eot|otf|ttf|ttc|woff|woff2|font.css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
    },
    {
      "target": "health",
      "public": "health/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|eot|otf|ttf|ttc|woff|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "scripts",
        "tests"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run typecheck"
      ]
    },
    {
      "source": "health/functions",
      "codebase": "health",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "scripts",
        "tests"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run typecheck"
      ]
    }
  ]
}
