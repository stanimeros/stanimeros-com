---
import BaseLayout from '@/layouts/BaseLayout.astro'
import LocalizedProjectDetail from '@/page-content/ProjectDetail.localized'
import { projectItems, keyToSlug } from '@/lib/projects-data'
import { projectDetailSeo } from '@/i18n/seo'
import elMain from '@/i18n/locales/el/main.json'

export function getStaticPaths() {
  return projectItems.map((item) => ({
    params: { slug: keyToSlug(item.key) },
    props: { item },
  }))
}

const { item } = Astro.props
const { slug } = Astro.params
const copy = (elMain.projects?.items as Record<string, { title: string; description: string }> | undefined)?.[item.key]
const s = projectDetailSeo('el', slug, copy?.title ?? item.key, copy?.description ?? '')
---

<BaseLayout lang="el" {...s}>
  <LocalizedProjectDetail lang="el" slug={slug} client:load />
</BaseLayout>
