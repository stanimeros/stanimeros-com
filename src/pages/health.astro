---
import BareLayout from '@/layouts/BareLayout.astro'
import Health from '@/page-content/Health'
---

<!--
  Internal dashboard. The page shell is public and static like every other page
  on the site — only the data behind it is gated, by firestore.rules' admin-UID
  check on the health_* collections the client reads directly. So nothing
  sensitive may be rendered here at build time: no project list, no UIDs, no
  config. Uses a bare layout (no particles/header/footer) since this is a
  tool, not a marketing page.
-->
<BareLayout
  lang="en"
  title="Health"
  description="Internal system health dashboard."
  canonical="https://stanimeros.com/health"
  noindex={true}
>
  <Health client:load />
</BareLayout>
