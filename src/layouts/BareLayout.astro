---
import '@/index.css'

interface Props {
  lang: 'en' | 'el'
  title: string
  description: string
  canonical: string
  noindex?: boolean
}

const { lang, title, description, canonical, noindex = false } = Astro.props
---

<!--
  Minimal shell for internal tooling pages: no particles background, no
  public header/footer/chat/banners. Just the document chrome.
-->
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/logo-glass-black.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&display=swap&subset=greek,latin"
      media="print"
      onload="this.media='all'"
    />
  </head>
  <body>
    <div class="min-h-svh bg-background text-foreground">
      <slot />
    </div>
  </body>
</html>
